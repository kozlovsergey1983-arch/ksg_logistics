# Set these in the Timeweb application environment, not in GitHub.
APP_ENV=production
PORT=8080
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=require
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_LOGIN=admin
ADMIN_NAME=Сергей
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_TEMPORARY_PASSWORD

# Optional, use verified company details and inject Diadoc credentials as secrets.
CONTRACT_COMPANY_JSON={}
DIADOC_BOX_ID=
DIADOC_ACCESS_TOKEN=
DIADOC_SIGNER_LOGIN=
